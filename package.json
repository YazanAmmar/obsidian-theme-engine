{
  "name": "theme-engine",
  "version": "2.1.0",
  "description": "Take full control of your workspace with dynamic theme profiles, live overrides, and a powerful customization engine built for complete visual freedom.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "format": "prettier --write \"src/**/*.{ts,scss}\"",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "build": "npm run check && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs dev"
  },
  "keywords": [],
  "author": "Yazan Ammar",
  "license": "MIT",
  "dependencies": {
    "sortablejs": "^1.15.7",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@types/sortablejs": "^1.15.9",
    "@typescript-eslint/utils": "^8.56.0",
    "cpy-cli": "^7.0.0",
    "esbuild": "^0.27.3",
    "esbuild-sass-plugin": "^3.6.0",
    "eslint": "^9.39.2",
    "eslint-plugin-obsidianmd": "^0.1.9",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.4.0",
    "globals": "^17.3.0",
    "obsidian": "^1.12.0",
    "prettier": "^3.8.1",
    "sass": "^1.97.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0"
  }
}
